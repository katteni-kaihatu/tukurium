config_version=5

[application]
config/name="tukurium"
run/main_scene="res://main.tscn"
config/icon="res://assets/branding/mascot.png"
boot_splash/image="res://assets/branding/logo.png"

[autoload]
AppLanguage="*res://app_language.gd"

[internationalization]
locale/fallback="ja"

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.07, 0.10, 0.14, 1)

[xr]
openxr/enabled=false
openxr/startup_alert=false
openxr/default_action_map="res://openxr_action_map.tres"
shaders/enabled=true
