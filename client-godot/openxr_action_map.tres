[gd_resource type="OpenXRActionMap" format=3]

[sub_resource type="OpenXRAction" id="OpenXRAction_6ivru"]
resource_name = "primary"
localized_name = "Move or turn"
action_type = 2
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_vfhwq"]
resource_name = "by_button"
localized_name = "VR menu"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_5w03k"]
resource_name = "trigger_click"
localized_name = "Select menu item"
action_type = 0
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRAction" id="OpenXRAction_typ1r"]
resource_name = "aim_pose"
localized_name = "Menu pointer"
action_type = 3
toplevel_paths = PackedStringArray("/user/hand/left", "/user/hand/right")

[sub_resource type="OpenXRActionSet" id="OpenXRActionSet_clvbf"]
resource_name = "navigation"
localized_name = "Navigation"
actions = [SubResource("OpenXRAction_6ivru"), SubResource("OpenXRAction_vfhwq"), SubResource("OpenXRAction_5w03k"), SubResource("OpenXRAction_typ1r")]

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_5bppb"]
action = SubResource("OpenXRAction_6ivru")
binding_path = "/user/hand/left/input/thumbstick"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_3k6la"]
action = SubResource("OpenXRAction_6ivru")
binding_path = "/user/hand/right/input/thumbstick"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_i8esw"]
action = SubResource("OpenXRAction_vfhwq")
binding_path = "/user/hand/left/input/b/click"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_um1hv"]
action = SubResource("OpenXRAction_vfhwq")
binding_path = "/user/hand/right/input/b/click"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_oqnsu"]
action = SubResource("OpenXRAction_5w03k")
binding_path = "/user/hand/left/input/trigger/click"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_r5bl7"]
action = SubResource("OpenXRAction_5w03k")
binding_path = "/user/hand/right/input/trigger/click"

[sub_resource type="OpenXRIPBinding" id="OpenXRIPBinding_ytptc"]
